<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No graphics <uses-feature>: the shared/base manifest is the GLES
         lowest common denominator, so Play doesn't filter out GLES-capable
         devices with weak/absent Vulkan. A future Vulkan-on-Android flavor
         declares its own android.hardware.vulkan.* requirement in its overlay. -->

    <application
        android:label="${appLabel}"
        android:hasCode="true"
        android:allowBackup="false"
        android:isGame="true"
        android:appCategory="game">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode|density"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Uldum">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Name of the .so GameActivity loads. Both dev and game
                 flavors build the same `uldum` target — the flavor
                 distinction lives at the APK level (applicationId, label,
                 bundled assets), not the library name. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="uldum" />
        </activity>
    </application>
</manifest>
